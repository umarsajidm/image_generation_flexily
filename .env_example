# ==========================================
# Image Generation Pipeline Environment Variables
# ==========================================

# Database connection (Flexily DB)
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/flexily

# Google Cloud Platform Configuration (Vertex AI)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=europe-north1

# Google Application Credentials (Path to JSON key file if running locally)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# Optional: Gemini API Key (if using direct API instead of Vertex AI)
# GEMINI_API_KEY=your-gemini-api-key
